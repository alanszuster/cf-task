#!/usr/bin/env bash
# Runs fmt, validate and terraform test for one module or stack, with a clean
# environment so the caller's API keys never reach Terraform.
set -euo pipefail

target="${1:?usage: tf-run-tests <modules/name | stacks/name>}"
root="$(pwd -P)"

case "$target" in
  modules/* | stacks/*) ;;
  *) echo "tf-run-tests: target must be modules/<name> or stacks/<name>" >&2; exit 2 ;;
esac

dir="$(realpath -e -- "$root/$target")"
case "$dir" in
  "$root"/modules/* | "$root"/stacks/*) ;;
  *) echo "tf-run-tests: $target is outside the repository" >&2; exit 2 ;;
esac

tf_home="$(mktemp -d)"
trap 'rm -rf "$tf_home"' EXIT

tf() {
  env -i \
    PATH="$PATH" \
    HOME="$tf_home" \
    TF_IN_AUTOMATION=1 \
    TF_INPUT=0 \
    ${TF_PLUGIN_CACHE_DIR:+TF_PLUGIN_CACHE_DIR="$TF_PLUGIN_CACHE_DIR"} \
    timeout 600 terraform -chdir="$dir" "$@"
}

lockfile_mode=()
[[ -f "$dir/.terraform.lock.hcl" ]] && lockfile_mode=(-lockfile=readonly)

step() {
  local name="$1"
  shift
  local out
  if ! out="$("$@" 2>&1)"; then
    echo "$name failed:"
    echo "$out"
    exit 1
  fi
}

if [[ -d "$dir/tests" ]]; then
  step fmt tf fmt -check -diff -recursive tests
fi
step init tf init -backend=false -no-color "${lockfile_mode[@]}"
step validate tf validate -no-color

if out="$(tf test -no-color 2>&1)"; then
  grep -E '^(Success|Failure)!' <<<"$out" || echo "$out"
else
  echo "$out"
  exit 1
fi
