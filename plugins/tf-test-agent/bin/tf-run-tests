#!/usr/bin/env bash
# Checks formatting, validates and runs `terraform test` for one module or stack.
# It is the only command the agent may run. Terraform runs with a clean
# environment, so API keys and tokens of the caller are not passed to it.
set -euo pipefail

target="${1:?usage: tf-run-tests <modules/name | stacks/name>}"
root="$(pwd -P)"

case "$target" in
  modules/* | stacks/*) ;;
  *) echo "tf-run-tests: target must be modules/<name> or stacks/<name>" >&2; exit 2 ;;
esac

dir="$(realpath -e -- "$root/$target")"
case "$dir" in
  "$root"/modules/* | "$root"/stacks/*) ;;
  *) echo "tf-run-tests: $target is outside the repository" >&2; exit 2 ;;
esac

tf_home="$(mktemp -d)"
trap 'rm -rf "$tf_home"' EXIT

tf() {
  env -i \
    PATH="$PATH" \
    HOME="$tf_home" \
    TF_IN_AUTOMATION=1 \
    TF_INPUT=0 \
    ${TF_PLUGIN_CACHE_DIR:+TF_PLUGIN_CACHE_DIR="$TF_PLUGIN_CACHE_DIR"} \
    timeout 600 terraform -chdir="$dir" "$@"
}

# Use the committed lock file as is, so a test run never changes provider versions.
lockfile_mode=()
[[ -f "$dir/.terraform.lock.hcl" ]] && lockfile_mode=(-lockfile=readonly)

# Output is short on success and complete on failure: everything printed here
# ends up in the agent's context.
step() {
  local name="$1"
  shift
  local out
  if ! out="$("$@" 2>&1)"; then
    echo "$name failed:"
    echo "$out"
    exit 1
  fi
}

# Only the test files are checked: formatting of the code under test belongs to
# the author of the change, not to the agent.
if [[ -d "$dir/tests" ]]; then
  step fmt tf fmt -check -diff -recursive tests
fi
step init tf init -backend=false -no-color "${lockfile_mode[@]}"
step validate tf validate -no-color

if out="$(tf test -no-color 2>&1)"; then
  grep -E '^(Success|Failure)!' <<<"$out" || echo "$out"
else
  echo "$out"
  exit 1
fi
