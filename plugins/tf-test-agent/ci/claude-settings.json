  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Skill",
      "Edit(modules/*/tests/**)",
      "Edit(stacks/*/tests/**)",
      "Bash(tf-run-tests:*)",
      "Bash(tf-mutate:*)"
